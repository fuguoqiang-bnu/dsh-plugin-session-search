{
  "name": "dsh-session-explorer",
  "version": "1.1.0",
  "description": "DeepSeek Harness 插件：把本机所有对话记录做成可搜索、可统计、会实时更新的面板——关键词高亮命中、会话活动热力图、工具调用排行、工作区分布，全部离线在本机完成。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.1.0-0"
    },
    "catalog": {
      "summary": "把本机所有对话记录做成一个面板：关键词检索（中文子串也能搜）、命中高亮、活动热力图、工具调用排行、工作区分布，边聊边更新。",
      "summaryEn": "Turn every conversation stored on this machine into one live panel: keyword search (CJK substrings included), highlighted hits, activity heatmap, tool-call ranking, workspace breakdown.",
      "category": "productivity",
      "capabilities": [
        "search",
        "history",
        "visualization",
        "session-index",
        "realtime"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-search",
    "conversation-search",
    "history",
    "visualization",
    "full-text-search"
  ],
  "license": "MIT"
}
